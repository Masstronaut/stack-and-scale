# Copy to .env for local development. Never commit real values.

# --- AWS credentials for the SST CLI (sst deploy / sst dev) -----------------
# Prefer `aws sso login` + AWS_PROFILE, or an SSO/Identity Center profile.
# Only set the static keys if you have no profile available.
AWS_REGION=us-east-1
# AWS_PROFILE=my-dev-profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Stage name for SST (defaults to your OS user when unset)
SST_STAGE=dev

# --- Deploy-time config, read by sst.config.ts ------------------------------
# Sender identity for SES. Must be verified in SES for the target account.
SES_SENDER_EMAIL=verified-sender@example.com

# --- Run artifacts & tracking ------------------------------------------------
# ARTIFACTS_BUCKET is NOT a .env var: it is an SST-linked private bucket
# (sst.aws.Bucket "Artifacts") wired into the workers and the /runs +
# /artifacts routes in sst.config.ts. Locally the run tracker and artifact
# sink run gated: with no bucket configured they skip writes and log.

# --- Local health server (npm run server) -----------------------------------
PORT=3000

# --- Box app credentials -----------------------------------------------------
# NOT read from .env at runtime: these are SST secrets. Set them per stage with:
#   npx sst secret set BOX_CLIENT_ID <value> --stage <stage>
#   npx sst secret set BOX_CLIENT_SECRET <value> --stage <stage>
#   npx sst secret set BOX_ENTERPRISE_ID <value> --stage <stage>
