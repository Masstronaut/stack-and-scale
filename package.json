{
  "name": "stack-and-scale",
  "version": "0.1.0",
  "private": true,
  "description": "SST + AWS job pipeline: SQS queue, SES email, Box file pulls, API Gateway health check",
  "type": "module",
  "scripts": {
    "renewer": "node src/renewal/server.ts",
    "test:renewer": "node --test scripts/test-renewer.ts",
    "dev": "sst dev",
    "server": "node --env-file=.env src/server.ts",
    "check": "vp check",
    "test": "vp test",
    "deploy": "sst deploy",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sesv2": "^3.908.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "box-node-sdk": "^10.18.0",
    "effect": "^4.0.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^24.7.0",
    "sst": "^4.17.2",
    "vite-plus": "^1.3.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0"
    }
  }
}
